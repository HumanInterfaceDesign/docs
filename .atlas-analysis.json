  "keyFeatures": [
    "Real-time subway arrival times",
    "Bus vehicle positions and tracking",
    "Service alerts for delays and planned work",
    "Nearby stops lookup by geolocation",
    "TypeScript-first with full type definitions",
    "Serverless-compatible with SQLite/Turso support",
    "Automatic GTFS data hydration",
    "Single consistent API across all MTA modes"
  ],
  "publicApiSurface": [
    "new MTA(apiKey)",
    "mta.subway.arrivals({ stopId, route })",
    "mta.bus.vehicles({ route })",
    "mta.alerts.current({ mode })",
    "mta.stops.near({ lat, lon, modes })"
  ]
